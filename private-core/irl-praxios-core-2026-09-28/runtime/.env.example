# PRAXIOS runtime server
HOST=127.0.0.1
PORT=8787

# Browser origins allowed to call the API. Comma-separated.
PRAXIOS_CORS_ORIGIN=https://deepanalytica.github.io

# Required when HOST is not localhost.
PRAXIOS_SERVER_TOKEN=

# Separate credential for human approval/decision endpoints.
PRAXIOS_HUMAN_TOKEN=

# 32-byte key encoded as base64 or 64 hex characters.
# Required when HOST is not localhost.
PRAXIOS_DATA_KEY=

# Persistent data directory.
PRAXIOS_DATA_DIR=.praxios-data

# Request limits.
PRAXIOS_MAX_BODY_BYTES=1000000
PRAXIOS_RATE_LIMIT_PER_MINUTE=120

# External model providers. Keys remain server-side.
OPENAI_API_KEY=
PRAXIOS_OPENAI_MODEL=

ANTHROPIC_API_KEY=
PRAXIOS_ANTHROPIC_MODEL=
